# ============================================================
# FAREBACK — Environment Variables Reference
# ============================================================
# Copy this file to .env.local and fill in real values.
# All values with defaults are OPTIONAL — they fall back to
# the defaults shown in src/config/app.ts.
# ============================================================

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/fareback

# ── App Identity (optional — has defaults) ────────────────────
NEXT_PUBLIC_APP_URL=https://www.fareback.in
NEXT_PUBLIC_APP_NAME=Fareback
NEXT_PUBLIC_APP_TAGLINE=Earn real cashback on every Amazon order
NEXT_PUBLIC_SUPPORT_EMAIL=support@fareback.in
NEXT_PUBLIC_ADMIN_CONTACT_EMAIL=admin@fareback.in
APP_TIMEZONE=Asia/Kolkata
APP_TIMEZONE_OFFSET=+05:30
APP_CURRENCY=INR
APP_CURRENCY_SYMBOL=₹

# ── Amazon Affiliate ──────────────────────────────────────────
# Change this to instantly update the primary tag everywhere (banners, buttons, fallbacks)
AMAZON_AFFILIATE_BASE_URL=https://www.amazon.in/?tag=fareback2-21
AMAZON_MERCHANT_ID=1
AFFILIATE_REDIS_LIST_KEY=affiliate:amazon:links
AFFILIATE_CACHE_TTL_SECONDS=30

# ── Non-Amazon Merchant Affiliate URLs (optional — has defaults)
FLIPKART_AFFILIATE_URL=https://fktr.in/49T8I82
MYNTRA_AFFILIATE_URL=https://myntr.it/auK4aA9
AJIO_AFFILIATE_URL=https://ajiio.in/xTvzcfm

# ── Merchant Lists (optional — comma-separated, lowercase)
# These control which merchants are live vs coming-soon
SUPPORTED_MERCHANTS=amazon,flipkart,myntra,ajio
COMING_SOON_MERCHANTS=flipkart,myntra,ajio
HERO_PRIORITY_MERCHANTS=amazon,flipkart,myntra

# ── Wallet Limits (optional — has defaults) ───────────────────
MIN_WITHDRAWAL_PAISE=100
MAX_WITHDRAWAL_PAISE=5000000

# ── Redirect & Click Tracking (optional — has defaults) ───────
REDIRECT_LOCK_TTL_SECONDS=3
REDIRECT_LOCK_WAIT_MS=40
RECENT_CLICK_TTL_SECONDS=86400
REDIRECT_RATE_LIMIT_MAX=30
REDIRECT_RATE_LIMIT_WINDOW_SECONDS=300

# ── Auth & Session (optional — has defaults) ──────────────────
SESSION_COOKIE_NAME=fareback_session
OTP_EXPIRY_SECONDS=300
PASSWORD_RESET_EXPIRY_SECONDS=3600
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_SECONDS=900
PASSWORD_HISTORY_LIMIT=5

# ── Admin ─────────────────────────────────────────────────────
ADMIN_EMAIL=your@email.com
ADMIN_EMAILS=your@email.com,another@email.com
ADMIN_USER_LIST_LIMIT=500
FINANCE_CLICKS_PAGE_SIZE=50

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Redis (Upstash) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Security Secrets ─────────────────────────────────────────
SESSION_SECRET=your-64-char-random-string
ENCRYPTION_MASTER_KEY=your-32-byte-base64-key
COMPARISON_SECRET=your-comparison-secret
API_SIGNING_SECRET=your-api-signing-secret
CRON_SECRET=your-cron-secret

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=no-reply@fareback.in
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret

# ── Bot Protection (Cloudflare Turnstile) ────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Security Monitoring ───────────────────────────────────────
SIEM_WEBHOOK_URL=https://your-siem-endpoint.com/ingest
SIEM_API_KEY=your-siem-api-key
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# ── Misc ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://www.fareback.in,https://fareback.in
CLAMAV_URL=https://your-clamav-endpoint.com
FORCE_JAVASCRIPT_ACTIONS_TO_NODE24=true
